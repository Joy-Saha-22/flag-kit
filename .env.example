NODE_ENV=development
PORT=3000

# Docker service credentials (used by docker-compose.yml interpolation only)
MONGO_ROOT_USERNAME=flagkit
MONGO_ROOT_PASSWORD=replace-with-a-long-mongo-password
MONGO_DB=flagkit
MONGO_PORT=27017
REDIS_PASSWORD=replace-with-a-long-redis-password
REDIS_PORT=6379

# Application connection strings (never commit real values)
MONGODB_URI=mongodb://flagkit:replace-with-a-long-mongo-password@localhost:27017/flagkit?authSource=admin
REDIS_URL=redis://:replace-with-a-long-redis-password@localhost:6379

# Must be at least 32 characters and must not be this placeholder
JWT_SECRET=replace-with-at-least-32-char-secret!!

# Seed script only. Password must be at least 12 characters.
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=replace-with-strong-demo-password
SEED_USER_NAME=Demo Admin

# Rate limits (all optional; defaults are in server/src/env.js)
# AUTH_RATE_LIMIT_IP_MAX=30
# AUTH_RATE_LIMIT_IP_WINDOW_SECONDS=60
# AUTH_RATE_LIMIT_EMAIL_MAX=20
# AUTH_RATE_LIMIT_EMAIL_WINDOW_SECONDS=60
# AUTH_BACKOFF_BASE_MS=500
# AUTH_BACKOFF_CAP_MS=30000
# AUTH_BACKOFF_QUIET_SECONDS=900
# PUBLIC_RATE_LIMIT_IP_MAX=120
# PUBLIC_RATE_LIMIT_IP_WINDOW_SECONDS=60
# DASHBOARD_RATE_LIMIT_USER_MAX=600
# DASHBOARD_RATE_LIMIT_USER_WINDOW_SECONDS=60
# SDK_RATE_LIMIT_KEY_MAX=6000
# SDK_RATE_LIMIT_KEY_WINDOW_SECONDS=60
# SDK_RATE_LIMIT_IP_MAX=12000
# SDK_RATE_LIMIT_IP_WINDOW_SECONDS=60
# SDK_EVENTS_MAX_BYTES=65536
# MAX_SSE_CONNECTIONS_PER_KEY=100
